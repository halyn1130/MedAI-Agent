digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.32", nodesep="0.42", ranksep="0.50", splines=ortho, dpi=210, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fillcolor="#F0F5FC", color="#93ACCC", penwidth=1.15, fontname="Apple SD Gothic Neo", fontsize=14, fontcolor="#253750", margin="0.22,0.18", width=3.2, height=0.72];
edge [color="#8392A5", penwidth=1.25, arrowsize=0.7, fontname="Apple SD Gothic Neo", fontsize=11, fontcolor="#596A80"];
input [label=<<B>기업 프로필·기준일</B><BR/><FONT POINT-SIZE="12" COLOR="#627187">기존 결과·보완 요청 입력</FONT>>, shape=parallelogram, style=filled, fillcolor="#F4F6F9", color="#A3AFBF", width=3.6];
check [label=<<B>입력·요청·검색 예산 검증</B>>];
scope [label=<<B>조사할 영역 선택</B><BR/><FONT POINT-SIZE="12" COLOR="#627187">외부 자원 / 핵심 인력 / 운영 사건</FONT>>];
search [label=<<B>선택 영역 자료 직접 검색</B><BR/><FONT POINT-SIZE="12" COLOR="#627187">날짜·출처·중복 확인</FONT>>];
facts [label=<<B>사실·예상 영향·대응·미확인 분리</B>>];
more [label=<<B>남은 영역이</B><BR/><B>있는가?</B>>, shape=diamond, style=filled, fillcolor="#FFF5DD", color="#CFB777", width=3.0, height=1.05];
validate [label=<<B>근거·항목 ID 검증 및 결과 취합</B><BR/><FONT POINT-SIZE="12" COLOR="#627187">운영 대비 OP1~OP5·C6 설계 적용</FONT>>];
out [label=<<B>risk_analysis 반환</B><BR/><FONT POINT-SIZE="12" COLOR="#627187">findings · coverage · 실사 질문</FONT><BR/><FONT POINT-SIZE="12" COLOR="#627187">자료 없음 ≠ 위험 없음</FONT>>, shape=parallelogram, style=filled, fillcolor="#F4F6F9", color="#A3AFBF", width=3.6];
input -> check [xlabel=""];
check -> scope [xlabel=""];
scope -> search [xlabel=""];
search -> facts [xlabel=""];
facts -> more [xlabel=""];
more -> search [xlabel="예"];
more -> validate [xlabel="아니요"];
validate -> out [xlabel=""];
send [label=<<B>결과를 06 투자 심사에 전달</B>>, shape=box, style="rounded,filled", fillcolor="#E7F3ED", color="#8CB7A0"];
out -> send [xlabel=""];
req [label=<<B>심사 보완 요청 수신</B><BR/><FONT POINT-SIZE="12" COLOR="#627187">기업당 최대 1라운드</FONT>>, shape=parallelogram, style=filled, fillcolor="#F4F6F9", color="#A3AFBF", width=3.6];
patch [label=<<B>지정 항목만 추가 수집·수정</B><BR/><FONT POINT-SIZE="12" COLOR="#627187">기존 근거 ID·요청 외 결과 유지</FONT>>];
send -> req [xlabel="요청이 있을 때",style=dashed,color="#9B90B6",fontcolor="#82719D"];
req -> patch [xlabel="",style=dashed,color="#9B90B6",fontcolor="#82719D"];
patch -> validate [xlabel="재검증 후 전체 결과 반환",style=dashed,color="#9B90B6",fontcolor="#82719D"];
}