digraph MedAI {
  graph [rankdir=LR, fontname="Apple SD Gothic Neo", label="MedAI-Agent · 7개 에이전트 / 시장·사업성만 RAG", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#eef4ff", fontname="Apple SD Gothic Neo"];
  edge [fontname="Apple SD Gothic Neo"];
  company [label="1 기업·제품 조사\n적격성 · 제품·AI 기능 · 대상 고객\n공개 기술 설명 · 출처·기준일·확인 상태"];
  available [shape=diamond, label="후보 있음?"];
  subgraph clusterAnalysis {
    label="동일 프로필로 병렬 분석";
    clinical [label="2 임상·인허가 분석\n자료 조회 · RAG 없음"];
    market [label="3 시장·사업성 분석\n시장·산업 보고서 RAG", fillcolor="#f3eaff"];
    traction [label="4 실적·성장성 분석\n매출·계약·유료 고객·도입 성과\nMOU·실증·상용 구분 / RAG 없음"];
    risk [label="5 리스크 분석\n고객 집중 · 계약 불확실성 · 데이터 의존성\n공개 근거·미확인 사항 · 실사 질문 / RAG 없음"];
  }
  knowledge [label="시장·사업성 지식베이스\n파싱 → 청크 → 임베딩 → 인덱스\n200페이지 이하",fillcolor="#f3eaff"];
  join [label="모든 분석 완료 후 취합"];
  review [label="6 투자 심사\n근거 검토 · Python 점수 계산\n정책 적용 / RAG 없음"];
  supplement [label="해당 Agent 보완 · 횟수 제한\n시장: RAG 재검색\n나머지: 자료 조회·재분석\n상한 도달: 정보 없음 규칙 적용"];
  report [label="7 보고서 작성 · RAG 없음\n투자 또는 전원 보류 보고서",fillcolor="#eaf7f2"];
  finish [label="Markdown → PDF · 출처 검증\n5페이지 / SUMMARY 1/2페이지\n저장 후 종료",fillcolor="#eaf7f2"];
  company -> available;
  available -> {clinical market traction risk} [label="있음"];
  knowledge -> market [style=dashed,label="검색 근거"];
  {clinical market traction risk} -> join;
  join -> review;
  review -> supplement [label="근거 부족·충돌 / 상한 미만"];
  supplement -> {clinical market traction risk} [style=dashed,label="해당 Agent만"];
  review -> company [label="보류: 결과 보존·다음 후보",color="#b7791f"];
  review -> report [label="투자",color="#16806a"];
  available -> report [label="없음 / 전원 보류 / 후보 상한",color="#b7791f"];
  report -> finish;
}
